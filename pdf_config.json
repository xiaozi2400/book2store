{
  "_comment": "PDF排版配置文件 - 测试版本：宽松排版",
  
  "page": {
    "_comment": "页面设置 - 增加边距",
    "paper_size": "letter",
    "margin_top": 50,
    "margin_bottom": 50,
    "margin_left": 50,
    "margin_right": 50,
    "background_color": "#f8f8f8"
  },
  
  "font": {
    "_comment": "字体配置 - 增大字体",
    "serif": "Source Han Serif SC,Noto Serif CJK SC,SimSun,STSong,serif",
    "sans": "Source Han Sans SC,Noto Sans CJK SC,SimHei,STHeiti,sans-serif",
    "mono": "Source Han Mono SC,Noto Sans Mono CJK SC,Consolas,Microsoft YaHei Mono,monospace",
    "default_size": 20,
    "mono_size": 16,
    "bilingual_default_size": 20,
    "bilingual_mono_size": 16,
    "title_size": 28,
    "heading_size": 24
  },
  
  "typography": {
    "_comment": "排版设置 - 宽松行距和段间距",
    "line_height": 2.2,
    "minimum_line_height": 180,
    "paragraph_indent": 2.5,
    "paragraph_spacing": 2.5,
    "justify": true,
    "hyphenate": true,
    "hyphenate_chinese": true
  },
  
  "header_footer": {
    "_comment": "页眉页脚设置",
    "header_template": "",
    "footer_template": "<div style=\"text-align:center;font-size:11pt;color:#666;margin-top:8pt;\">第 _PAGENUM_ 页 / 共 _TOTALPAGES_ 页</div>"
  },
  
  "toc": {
    "_comment": "目录设置",
    "add_toc": true,
    "toc_depth": 3,
    "toc_title": "目录",
    "use_bookmarks": true
  },
  
  "image": {
    "_comment": "图片设置",
    "dpi": 150,
    "max_width": 600,
    "max_height": 800
  },
  
  "advanced": {
    "_comment": "高级选项",
    "use_xmp_metadata": true,
    "mark_links": true,
    "page_numbers": true,
    "disable_resample": false,
    "preserve_cover_aspect_ratio": true
  },
  
  "reading": {
    "_comment": "阅读体验优化",
    "two_column": false,
    "page_break_before_h1": true,
    "keep_with_next": true,
    "widow_control": true
  },
  
  "css": {
    "_comment": "EPUB CSS样式 - 宽松排版",
    "paragraph_margin_bottom": "2.5em",
    "paragraph_line_height": "2.2",
    "paragraph_text_indent": "2.5em",
    "heading_margin_top": "2.0em",
    "heading_margin_bottom": "1.5em",
    "list_item_margin_bottom": "1.2em",
    "blockquote_margin": "2.0em",
    "blockquote_padding_left": "2.0em",
    "blockquote_border_left": "4px solid #999"
  }
}
